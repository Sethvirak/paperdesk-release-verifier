{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperdesk.invalid/contracts/private-release-s2-activation-output-v1.schema.json",
  "title": "PaperDesk private release V2 offline S2 activation output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outputType", "activationDocument", "package", "source", "receiptBindings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "outputType": {"const": "paperdesk-private-release-v2-offline-activation-output"},
    "activationDocument": {"type": "object"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha", "sha256", "size", "members"],
      "properties": {
        "sourceSha": {"$ref": "#/$defs/sha40"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "object"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "s1MergedSha",
        "s2ReviewedHeadSha",
        "s2MergedSha",
        "s2TreeSha",
        "s2SoleParentSha",
        "requiredPaths"
      ],
      "properties": {
        "repository": {"const": "Sethvirak/paperdesk-release-verifier"},
        "s1MergedSha": {"$ref": "#/$defs/sha40"},
        "s2ReviewedHeadSha": {"$ref": "#/$defs/sha40"},
        "s2MergedSha": {"$ref": "#/$defs/sha40"},
        "s2TreeSha": {"$ref": "#/$defs/sha40"},
        "s2SoleParentSha": {"$ref": "#/$defs/sha40"},
        "requiredPaths": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 512}
        }
      }
    },
    "receiptBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrapAuthorizationSha256",
        "bootstrapPreflightSha256",
        "bootstrapTerminalBundleSha256",
        "repinTerminalReceiptSha256"
      ],
      "properties": {
        "bootstrapAuthorizationSha256": {"$ref": "#/$defs/sha256"},
        "bootstrapPreflightSha256": {"$ref": "#/$defs/sha256"},
        "bootstrapTerminalBundleSha256": {"$ref": "#/$defs/sha256"},
        "repinTerminalReceiptSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
